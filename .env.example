# ==============================================================================
# Fondazione2 Environment Variables Configuration
# ==============================================================================
COMPOSE_PROJECT_NAME=fondazione2

# Global Execution Mode (Strictly paper-only for TASK-0002)
TRADING_MODE=paper
LIVE_ENABLED=false
LIVE_ARMED=false
LIVE_CONFIRMATION=

# Databases & Cache
POSTGRES_DB=fondazione
POSTGRES_USER=fondazione
POSTGRES_PASSWORD=
DATABASE_URL=

# Core Services Authentication Keys
DECISION_API_KEY=

# Kronos Forecasting Service Setup
KRONOS_BACKEND=real
KRONOS_URL=http://kronos:8081

# Nemotron SGLang Inference Setup
AI_BACKEND=sglang
NEMOTRON_URL=http://nemotron:30000/v1
NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-Nano-9B-v2
HF_TOKEN=
SGLANG_MEM_FRACTION=0.88

# Coinbase Public Market Products Normalization
COINBASE_PRODUCTS=BTC-USDC,ETH-USDC

# Paper Initial Trading Capital (Must be configured explicitly; no default value)
# PAPER_INITIAL_CASH=
TEST_POSTGRES_URL=

# Observability, Grafana and Gateway Caddy Domains
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
FOUNDATION_DOMAIN=fondazione.pianodivino.com
GRAFANA_ROOT_URL=https://fondazione.pianodivino.com
GRAFANA_COOKIE_SECURE=true
