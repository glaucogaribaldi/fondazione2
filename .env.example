COMPOSE_PROJECT_NAME=fondazionesemplice
TRADING_MODE=paper
LIVE_ENABLED=false
LIVE_CONFIRMATION=

DECISION_API_KEY=change-me-with-openssl-rand-hex-32
DATABASE_URL=postgresql://fondazione:change-me@postgres:5432/fondazione
POSTGRES_DB=fondazione
POSTGRES_USER=fondazione
POSTGRES_PASSWORD=change-me

AI_BACKEND=mock
KRONOS_BACKEND=mock
KRONOS_URL=http://kronos:8081
NEMOTRON_URL=http://nemotron:30000/v1
NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-Nano-9B-v2
HF_TOKEN=
SGLANG_IMAGE=lmsysorg/sglang:v0.5.15.post1
SGLANG_MEM_FRACTION=0.88

ARENA_INITIAL_CAPITAL=310
ARENA_SYMBOLS=BTC/USDT,ETH/USDT
PAPER_FEE_BPS=60
PAPER_SLIPPAGE_BPS=5
COINBASE_PRODUCTS=BTC-USDT,ETH-USDT
MARKET_TIMEFRAME_SECONDS=300
MARKET_POLL_SECONDS=30
MARKET_CANDLE_LIMIT=96
DECISION_TIMEOUT_SECONDS=60
ARENA_DECISION_TIMEOUT_SECONDS=90

OCTOBOT_IMAGE=drakkarsoftware/octobot:2.1.1
OCTOBOT_BIND=127.0.0.1
OCTOBOT_PORT=5001
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
FOUNDATION_DOMAIN=fondazione.pianodivino.com
GRAFANA_ROOT_URL=https://fondazione.pianodivino.com
GRAFANA_COOKIE_SECURE=true
