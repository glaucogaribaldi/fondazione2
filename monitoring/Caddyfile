{$FOUNDATION_DOMAIN:fondazione.pianodivino.com} {
	encode zstd gzip

	@method_pdf path /fondazione-semplice-metodo.pdf
	handle @method_pdf {
		root * /srv/pdf
		rewrite * /fondazione-semplice-metodo.pdf
		header Content-Disposition "attachment; filename=fondazione-semplice-metodo.pdf"
		file_server
	}

	handle {
		reverse_proxy grafana:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
}
